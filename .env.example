# ============================================================
# Admin auth — COPY to .env.local (gitignored). NEVER commit secrets.
# ============================================================

# Random secret for signing session JWTs (openssl rand -base64 32)
NEXTAUTH_SECRET=replace-me-with-a-long-random-string

NEXTAUTH_URL=http://localhost:3000

# bcrypt hash of a bootstrap password, BASE64-ENCODED (avoids Next `$` env bug).
# Generate:
#   node -e "require('bcryptjs').hash('YOUR_PASSWORD',12).then(h=>console.log(Buffer.from(h).toString('base64')))"
ADMIN_PASSWORD_HASH_B64=

# Existing server secrets (already used elsewhere) — keep server-only:
# EMAIL_SERVER=
# CAPTCHA_SECRET=
# PRIVATE_KEY=
# PRIVATE_KEY_ID=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Never prefix these with NEXT_PUBLIC_
